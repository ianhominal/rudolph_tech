<Window x:Class="RudolphTech.Settings.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rudolph Tech"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource Headline}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" x:Name="Subtitle" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBox Grid.Row="2" x:Name="ValueInput" Padding="8,6" Margin="0,0,0,8" KeyDown="OnValueKeyDown" />

        <TextBlock Grid.Row="3" x:Name="ErrorText" Style="{StaticResource Muted}" Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" MinHeight="18" Margin="0,0,0,12" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="OnCancel" Margin="0,0,8,0" />
            <Button x:Name="AcceptButton" Content="Guardar" Style="{StaticResource PrimaryButton}" Click="OnAccept" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
