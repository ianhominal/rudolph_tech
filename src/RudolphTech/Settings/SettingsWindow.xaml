<Window x:Class="RudolphTech.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rudolph Tech"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True"
        Background="#F5F5F5">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title and status pill -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Rudolph Tech" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" CornerRadius="10" Padding="10,4" Background="{Binding PillBackground}" VerticalAlignment="Center">
                <TextBlock Text="{Binding PillText}" Foreground="{Binding PillForeground}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Estado -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Headline}" Style="{StaticResource Headline}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        Content="{Binding PrimaryActionText}"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding PrimaryActionEnabled}"
                        ToolTip="{Binding PrimaryActionTooltip}"
                        VerticalAlignment="Top"
                        Click="OnPrimaryAction" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LastRunLine}" Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,6,12,0" />
            </Grid>
        </Border>

        <!-- Cuándo releva -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding ScheduleGroupEnabled}">
            <StackPanel>
                <TextBlock Text="Cuándo releva" Style="{StaticResource Headline}" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Relevar todos los días" IsChecked="{Binding DailyEnabled}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding DailyTimeEnabled}">
                        <TextBlock Text="a las" Style="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding DailyTimeText, UpdateSourceTrigger=LostFocus}"
                                 BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Todos los días releva todos los productos configurados." Style="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,4,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Buscar pedidos hechos desde la web" IsChecked="{Binding PendingEnabled}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding PendingControlsEnabled}">
                        <TextBlock Text="cada" Style="{StaticResource Muted}" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding PendingIntervalText, UpdateSourceTrigger=LostFocus}"
                                 BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" />
                        <TextBlock Text="minutos" Style="{StaticResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Cuando alguien toca Actualizar en la aplicación, esta PC lo releva en los minutos siguientes."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Opciones -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding OptionsGroupEnabled}">
            <StackPanel>
                <TextBlock Text="Opciones" Style="{StaticResource Headline}" Margin="0,0,0,10" />
                <CheckBox Content="Chrome fuera de la pantalla" IsChecked="{Binding ChromeOffScreen}" />
                <TextBlock Text="Abre Chrome fuera del área visible de la pantalla mientras releva."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
                <CheckBox Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Text="Arranca Rudolph Tech solo cuando encendés esta PC."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Vinculación con la aplicación -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Vinculación con la aplicación" Style="{StaticResource Headline}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding LinkSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding WebActionsVisible, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Actualizar agente" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding UpdateAgentEnabled}" Click="OnUpdateAgent" />
                    <Button Content="Volver a vincular" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding RelinkEnabled}" Click="OnRelink" Margin="8,0,0,0" />
                </StackPanel>
                <Button Content="Cambiar la dirección de la aplicación" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding ChangeAddressVisible, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding ChangeAddressEnabled}"
                        Click="OnChangeAddress" />
            </StackPanel>
        </Border>

        <!-- Status message -->
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="18">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Footer -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Abrir Rudolph en el navegador" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnOpenBrowser" />
            <Button Grid.Column="1" Content="Ver registro" Style="{StaticResource LinkButton}"
                    VerticalAlignment="Center" Margin="0,0,16,0" Click="OnOpenLogs" />
            <Button Grid.Column="2" Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
